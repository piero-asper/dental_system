NODE_ENV=development
PORT=3000
# En desarrollo local se permiten ambos nombres equivalentes del navegador.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Sustituye USER, PASSWORD y el host por las credenciales de tu entorno.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/dental_system?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/dental_system?schema=public

# Usa las credenciales públicas y de servicio de tu proyecto Supabase.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
